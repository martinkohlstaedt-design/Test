# Secrets — never commit these
.env
trading-bot/.env
trading-bot/config.yaml

# Python
__pycache__/
*.pyc
.venv/
venv/

# Bot runtime data (trade logs, local state) — not source, don't version it
trading-bot/logs/
trading-bot/*.jsonl
trading-bot/*.db

# OS/editor cruft
.DS_Store

# NFI Kraken Futures: keine Konfiguration mit Schluesseln, keine Daten/Datenbanken
nfi-krakenfutures/**/config*.json
nfi-krakenfutures/**/*.sqlite
nfi-krakenfutures/user_data/
