# Copy to .env (gitignored) and fill in only if you switch config.yaml's
# mode to "live". Paper trading needs none of this.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Extra, deliberate safety switch: LiveBroker refuses to start unless this is
# exactly "true". Its purpose is to make going live a conscious decision you
# type out, not a config typo. Only set it once you have paper-traded and
# backtested your strategy and accept that live trading risks real money.
I_UNDERSTAND_LIVE_TRADING_RISK=false
